{
  "expo": {
    "name": "Corridor",
    "slug": "corridor",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "corridor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14120F",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.corridor.app"
    },
    "android": {
      "package": "dev.corridor.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14120F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#14120F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37bed8c2-bd34-43f1-9044-345207648012"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/37bed8c2-bd34-43f1-9044-345207648012"
    }
  }
}
