{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // The domain layer runs under `node --test` as well as inside Metro, and
    // Node's ESM resolver requires explicit extensions. Metro resolves them fine.
    "allowImportingTsExtensions": true,
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
